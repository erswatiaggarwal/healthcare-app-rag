# ── OpenAI Cloud (development / non-PHI) ──────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_NAME=gpt-4.1-mini

# ── Pinecone (primary vector store) ───────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=healthcare-app-rag
# Index must be created with: dims=512, metric=cosine, cloud=aws, region=us-east-1

# ── ChromaDB fallback (auto-activated when Pinecone keys are absent) ──
CHROMA_PERSIST_DIR=./chroma_db

# ── Nebius AI Studio (production / PHI-safe) ──────────────────────
# Set NEBIUS_API_KEY to activate Nebius mode. build_llm() switches automatically.
NEBIUS_API_KEY=
# Get your key at: https://studio.nebius.com
NEBIUS_MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct
# Other available models: Qwen/Qwen3-32B
#                         deepseek-ai/DeepSeek-V3.2
#                         NousResearch/Hermes-4-70B
